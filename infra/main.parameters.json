{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "resourceGroupName": {
      "value": "${AZURE_RESOURCE_GROUP}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "principalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "openAiServiceLocation": {
      "value": "${AZURE_OPENAI_SERVICE_LOCATION}"
    },
    "openAiServiceName": {
      "value": "${AZURE_OPENAI_SERVICE}"
    },
    "openAiResourceGroupName": {
      "value": "${AZURE_OPENAI_RESOURCE_GROUP}"
    },
    "reuseExistingOpenAi": {
      "value": "${AZURE_OPENAI_REUSE_EXISTING=false}"
    },
    "openAiEndpoint": {
      "value": "${AZURE_OPENAI_EASTUS2_ENDPOINT}"
    },
    "openAiRealtimeDeployment": {
      "value": "${AZURE_OPENAI_REALTIME_DEPLOYMENT}"
    },
    "openAiRealtimeVoiceChoice": {
      "value": "${AZURE_OPENAI_REALTIME_VOICE_CHOICE=marin}"
    },
    "openAiRealtimeReasoningEffort": {
      "value": "${AZURE_OPENAI_REALTIME_REASONING_EFFORT}"
    },
    "openAiRealtimeReasoningModel": {
      "value": "${AZURE_OPENAI_REALTIME_REASONING_MODEL}"
    },
    "openAiRealtimeTranscriptionModel": {
      "value": "${AZURE_OPENAI_REALTIME_TRANSCRIPTION_MODEL}"
    },
    "searchIndexName": {
      "value": "${AZURE_SEARCH_INDEX=sonic-menu-items}"
    },
    "searchSemanticConfiguration":{
      "value": "${AZURE_SEARCH_SEMANTIC_CONFIGURATION=menuSemanticConfig}"
    },
    "searchIdentifierField": {
      "value": "${AZURE_SEARCH_IDENTIFIER_FIELD=id}"
    },
    "searchContentField": {
      "value": "${AZURE_SEARCH_CONTENT_FIELD=description}"
    },
    "searchTitleField": {
      "value": "${AZURE_SEARCH_TITLE_FIELD=name}"
    },
    "searchEmbeddingField": {
      "value": "${AZURE_SEARCH_EMBEDDING_FIELD=embedding}"
    },
    "searchUseVectorQuery": {
      "value": "${AZURE_SEARCH_USE_VECTOR_QUERY=true}"
    },
    "searchServiceName": {
      "value": "${AZURE_SEARCH_SERVICE}"
    },
    "searchServiceResourceGroupName": {
      "value": "${AZURE_SEARCH_SERVICE_RESOURCE_GROUP}"
    },
    "searchServiceLocation": {
      "value": "${AZURE_SEARCH_SERVICE_LOCATION}"
    },
    "searchServiceSkuName": {
      "value": "${AZURE_SEARCH_SERVICE_SKU=basic}"
    },
    "searchServiceSemanticRankerLevel": {
      "value": "${AZURE_SEARCH_SEMANTIC_RANKER=free}"
    },
    "reuseExistingSearch": {
      "value": "${AZURE_SEARCH_REUSE_EXISTING=false}"
    },
    "searchEndpoint": {
      "value": "${AZURE_SEARCH_ENDPOINT}"
    },
    "storageAccountName": {
      "value": "${AZURE_STORAGE_ACCOUNT}"
    },
    "storageResourceGroupName": {
      "value": "${AZURE_STORAGE_RESOURCE_GROUP}"
    },
    "storageSkuName": {
      "value": "${AZURE_STORAGE_SKU=Standard_LRS}"
    },
    "backendServiceName": {
      "value": "${AZURE_CONTAINER_APP_NAME}"
    },
    "realtimeDeploymentCapacity": {
      "value": "${AZURE_OPENAI_REALTIME_DEPLOYMENT_CAPACITY=10}"
    },
    "realtime21MiniDeploymentCapacity": {
      "value": "${AZURE_OPENAI_REALTIME_21_MINI_DEPLOYMENT_CAPACITY=10}"
    },
    "embeddingDeploymentCapacity": {
      "value": "${AZURE_OPENAI_EMB_DEPLOYMENT_CAPACITY=30}"
    },
    "embeddingDimensions": {
      "value": "${AZURE_OPENAI_EMB_DIMENSIONS}"
    },
    "personas": {
      "value": "${PERSONAS=}"
    },
    "defaultPersona": {
      "value": "${DEFAULT_PERSONA=}"
    },
    "deployDotnetApp": {
      "value": "${DEPLOY_DOTNET_APP=false}"
    },
    "dotnetServiceName": {
      "value": "${AZURE_CONTAINER_APP_DOTNET_NAME}"
    },
    "backendDotnetIngressEnabled": {
      "value": "${BACKEND_DOTNET_INGRESS_ENABLED=false}"
    },
    "logAnalyticsName": {
      "value": "${AZURE_LOG_ANALYTICS}"
    },
    "runningOnGh": {
      "value": "${GITHUB_ACTIONS}"
    },
    "runningOnAdo": {
      "value": "${TF_BUILD}"
    },
    "webAppExists": {
      "value": "${SERVICE_BACKEND_RESOURCE_EXISTS=false}"
    },
    "dotnetWebAppExists": {
      "value": "${SERVICE_BACKEND_DOTNET_RESOURCE_EXISTS=false}"
    },
    "azureContainerAppsWorkloadProfile": {
      "value": "${AZURE_CONTAINER_APPS_WORKLOAD_PROFILE=Consumption}"
    },
    "appSessionSecret": {
      "value": "${APP_SESSION_SECRET=}"
    },
    "entraTenantId": {
      "value": "${ENTRA_TENANT_ID=}"
    },
    "entraClientId": {
      "value": "${ENTRA_CLIENT_ID=}"
    },
    "entraApiScope": {
      "value": "${ENTRA_API_SCOPE=access_as_user}"
    },
    "entraAppRole": {
      "value": "${ENTRA_APP_ROLE=DriveThru.User}"
    },
    "backendIngressEnabled": {
      "value": "${BACKEND_INGRESS_ENABLED=true}"
    }
  }
}
