<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Conformance.Fakes</RootNamespace>
    <!-- Library only: hosted programmatically by Conformance.Harness/Conformance.Tests, never launched directly. -->
    <OutputType>Library</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Issue #143 (ADR-002): FakeEntraIssuer.Mint signs tokens directly with this library. -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
  </ItemGroup>

</Project>
