{
  "$schema": "../persona.schema.json",
  "schemaVersion": 1,
  "id": "tacobell",
  "displayName": "Taco Bell",
  "roleName": "crew associate",
  "locales": { "default": "en", "supported": ["en"] },
  "store": { "timezone": "America/New_York" },
  "voice": { "default": "marin" },
  "search": { "indexName": "tacobell-menu-items", "contentFields": ["description"] },
  "pricing": { "taxRate": "0.08", "happyHour": null },
  "sizes": {
    "canonical": { "standard": "Standard", "small": "Small", "medium": "Medium", "large": "Large" },
    "aliases": { "s": "small", "m": "medium", "l": "large", "regular": "standard" },
    "spokenAs": {}, "hidden": ["", "standard", "n/a"], "default": null
  },
  "bundles": {
    "nameMarkers": ["combo"], "convertStandalone": false,
    "missingPartText": { "sides": "a side", "drinks": "a drink" },
    "resizeRule": "componentUpcharge", "includedSize": "Medium"
  },
  "extras": { "allowedBaseCategories": [], "blockedBaseCategories": [], "splitCombinedNames": false },
  "invalidModifiers": { "drink": ["beef", "lettuce", "cheese"], "taco": ["whipped cream", "espresso"] },
  "machines": {},
  "models": {
    "realtime": { "default": "gpt-realtime-2.1-mini", "allowed": ["gpt-realtime-2.1", "gpt-realtime-2.1-mini"] },
    "cascade": { "default": "gpt-5-mini", "allowed": ["gpt-5-mini"] }
  },
  "strategies": { "searchQueryRewrite": "none" },
  "features": { "dayparts": false },
  "rewardsDemo": {
    "codes": { "DEMO-PLUS": 500, "DEMO-NEW": 0 },
    "pointsPerDollar": 10, "rewardItem": "Crunchy Taco", "preferredRewardItems": ["Cinnamon Twists"], "rewardCost": 250
  },
  "ui": {
    "title": "Taco Bell Voice Ordering Demo",
    "theme": {
      "light": {
        "primary": "268 81% 33%", "secondary": "285 65% 32%",
        "background": "270 50% 98%", "foreground": "270 40% 12%",
        "accents": {
          "primaryHex": "#501098", "primaryStrong": "#3B0B71", "primaryLight": "#9A23F8",
          "primaryTintOnDark": "#D8B4FE", "secondaryHex": "#70208A", "secondaryStrong": "#501098",
          "secondaryTintOnDark": "#F5C4EE", "accent": "#EA42D1", "accentLight": "#F5B1EB",
          "ink": "#23122F", "surfaceTint": "#F8F3FF", "surfaceDark": "#1E132A",
          "surfaceDarkAlt": "#2C193D", "success": "#287A45", "neutral": "#D7CEDF"
        },
        "surface": { "accentForeground": "270 40% 12%", "mutedForeground": "270 15% 35%" }
      },
      "dark": { "primary": "270 95% 82%", "foreground": "270 40% 96%" },
      "font": { "family": "Arial" }
    },
    "assets": { "logo": "assets/logo.svg", "logoTile": true, "favicon": "assets/logo.svg", "apologyClip": "assets/audio/apology-{lang}.wav" },
    "strings": {
      "en": {
        "app.title": "Taco Bell Voice Ordering Demo",
        "status.notRecordingMessage": "Live Más. Let's build your demo order.",
        "ticket.kicker": "Live Más demo ticket",
        "ticket.title": "Your Taco Bell Order",
        "menu.button": "View Taco Bell Demo Menu",
        "menu.title": "Taco Bell Favorites · Sample Prices",
        "ticket.emptyHint": "Start with a taco or Crunchwrap, then try demo rewards."
      }
    },
    "hero": {
