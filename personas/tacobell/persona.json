      "description": "Live Más. Explore Taco Bell favorites and simulated rewards check-in. All prices and 8% tax are illustrative, not restaurant 036309 quotes, now voice activated with Microsoft Foundry + Azure AI Search grounding.",
      "callouts": [
        { "title": "CHECK IN", "detail": "Use fictional demo codes only. No real member data.", "tone": "primary" },
        { "title": "FOUNDRY INFUSION", "detail": "Microsoft Foundry + Azure OpenAI keep conversations flowing", "tone": "secondary" },
        { "title": "REWARDS READY", "detail": "Explore session-only demo points and a sample reward.", "tone": "accent" }
