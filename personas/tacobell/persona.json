        {
          "icon": "assets/taco-illustration.svg", "kicker": "MAKE IT YOURS",
          "title": "Crunchwrap Supreme", "body": "Explore tacos, burritos, specialties, sides and drinks.",
          "accent": "Original illustrations. Sample menu prices. No real purchases.", "tone": "primary"
