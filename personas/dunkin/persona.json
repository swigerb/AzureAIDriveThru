{
  "$schema": "../persona.schema.json",
  "schemaVersion": 1,
  "id": "dunkin",
  "displayName": "Dunkin'",
  "roleName": "crew",
  "locales": {
    "default": "en",
    "supported": [
      "en",
      "es",
      "fr",
      "ja"
    ]
  },
  "store": {
    "timezone": "America/New_York"
  },
  "voice": {
    "default": "marin"
  },
  "search": {
    "indexName": "dunkin-menu-items",
    "contentFields": [
      "description"
    ]
  },
  "pricing": {
    "taxRate": "0.08",
    "happyHour": {
      "startHour": 14,
      "endHour": 17,
      "priceMultiplier": "0.75",
      "announce": true,
      "banner": "[HAPPY HOUR ACTIVE: standalone signature lattes and cold beverages are 25% off; donuts, bakery, breakfast sandwiches, and combo components are full price]"
    }
  },
  "sizes": {
    "canonical": {
      "small": "Small",
      "medium": "Medium",
      "large": "Large",
      "xlarge": "Extra Large",
      "standard": "Standard",
      "10 count": "10 Count",
      "25 count": "25 Count",
      "50 count": "50 Count"
    },
    "aliases": {
      "s": "small",
      "sm": "small",
      "m": "medium",
      "med": "medium",
      "l": "large",
      "lg": "large",
      "xl": "xlarge",
      "xlarge": "xlarge",
      "extralarge": "xlarge",
      "10": "10 count",
      "10ct": "10 count",
      "10count": "10 count",
      "10pack": "10 count",
      "25": "25 count",
