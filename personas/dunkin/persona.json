      "xlarge": "Extra Large",
      "10 count": "10 Count",
      "25 count": "25 Count",
      "50 count": "50 Count"
    },
    "hidden": [
      "",
      "standard",
      "n/a",
      "na",
      "none",
      "n.a."
    ],
    "default": null
  },
  "bundles": {
    "nameMarkers": [],
    "convertStandalone": false,
    "missingPartText": {}
  },
  "extras": {
    "allowedBaseCategories": [
      "hot drinks",
      "signature lattes",
      "cold beverages"
    ],
    "blockedBaseCategories": [
      "donuts & bakery",
      "breakfast sandwiches",
      "snacks & sides"
    ],
    "splitCombinedNames": true
  },
  "invalidModifiers": {},
  "pronunciations": {
    "Munchkins": "Munch-kins"
  },
  "machines": {},
  "models": {
    "realtime": {
      "default": "gpt-realtime-2.1",
      "allowed": [
        "gpt-realtime-2.1",
        "gpt-realtime-mini"
      ]
    },
    "cascade": {
      "default": "gpt-5-mini",
      "allowed": [
        "gpt-5-mini"
      ]
    }
  },
  "strategies": {
    "searchQueryRewrite": "none"
  },
  "features": {
    "dayparts": false
  },
