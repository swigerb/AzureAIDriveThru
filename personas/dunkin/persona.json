{
  "$schema": "../persona.schema.json",
  "schemaVersion": 1,
  "id": "dunkin",
  "displayName": "Dunkin'",
  "roleName": "crew",
  "locales": { "default": "en", "supported": ["en", "es", "fr", "ja"] },
  "store": { "timezone": "America/New_York" },
  "voice": { "default": "marin" },
  "search": { "indexName": "dunkin-menu-items", "contentFields": ["description"] },

  "pricing": {
    "taxRate": "0.08",
    "happyHour": {
      "startHour": 14,
      "endHour": 17,
      "priceMultiplier": "0.75",
      "announce": true,
      "banner": "[HAPPY HOUR ACTIVE: signature lattes and cold beverages are 25% off; donuts, bakery, and breakfast sandwiches are full price]"
    }
  },

  "sizes": {
    "canonical": { "small": "Small", "medium": "Medium", "large": "Large", "standard": "Standard" },
    "aliases": {},
    "spokenAs": {},
    "hidden": ["", "standard", "n/a", "na", "none", "n.a."],
    "default": null
  },

  "bundles": {
    "nameMarkers": [],
    "convertStandalone": false,
    "missingPartText": {}
  },

  "extras": {
    "allowedBaseCategories": ["signature lattes", "cold beverages"],
    "blockedBaseCategories": ["donuts & bakery", "breakfast sandwiches"],
    "splitCombinedNames": true
  },

  "invalidModifiers": {},
  "machines": {},

  "models": {
    "realtime": { "default": "gpt-realtime-2.1", "allowed": ["gpt-realtime-2.1", "gpt-realtime-mini"] },
    "cascade": { "default": "gpt-5-mini", "allowed": ["gpt-5-mini"] },
    "local": { "default": "phi-4-mini-local", "allowed": ["phi-4-mini-local"] }
  },

  "strategies": { "searchQueryRewrite": "none" },
  "features": { "dayparts": false },

  "ui": {
    "title": "Dunkin' Voice Ordering",
    "theme": {
      "light": { "primary": "28 100% 58%", "secondary": "329 100% 45%", "background": "32 77% 96%", "foreground": "17 40% 25%",
        "accents": {
          "primaryHex": "#FF671F",
          "primaryStrong": "#d9551a",
          "primaryLight": "#FF9F45",
          "primaryTintOnDark": "#FFB38F",
          "secondaryHex": "#E3007F",
          "secondaryStrong": "#c2006c",
          "secondaryTintOnDark": "#FF9FC5",
          "accent": "#FFD400",
          "accentLight": "#FFE784",
          "ink": "#7A2E10",
          "surfaceTint": "#FFF2E5",
          "surfaceDark": "#151317",
          "surfaceDarkAlt": "#2b1a13"
        }
      },
      "dark": { "primary": "28 100% 62%" },
      "font": { "family": "Fredoka", "importUrl": "https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Montserrat:wght@400;600&display=swap" }
    },
    "assets": { "logo": "assets/logo.svg", "favicon": "assets/favicon.ico", "apologyClip": "assets/audio/apology-{lang}.wav" },
    "strings": {
      "en": {
        "app.title": "Dunkin' Voice Crew",
        "status.notRecordingMessage": "Let's order some coffee!",
        "ticket.kicker": "Crew ticket",
        "ticket.title": "Your Dunkin Order",
        "menu.button": "View Dunkin Menu"
      }
    },
    "hero": { "headline": "Dunkin ordering powered by Microsoft Foundry", "callouts": [] },
    "legal": "Disclaimer: This project is a non-commercial demo application created for educational and illustrative purposes only. It is not affiliated with, endorsed, or sponsored by Inspire Brands, Inc. Any references to Dunkin' or use of Dunkin-inspired colors or themes are solely for demonstration and do not represent an official product."
  }
}
