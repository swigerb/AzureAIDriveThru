<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <!--
      Every rule in the Security, Reliability, Performance, and Usage categories is a build warning
      (most are off by default at AnalysisLevel=latest); .editorconfig opts out of the few that
      don't fit this codebase.
    -->
    <AnalysisModeSecurity>All</AnalysisModeSecurity>
    <AnalysisModeReliability>All</AnalysisModeReliability>
    <AnalysisModePerformance>All</AnalysisModePerformance>
    <AnalysisModeUsage>All</AnalysisModeUsage>
    <!--
      Enforce .editorconfig code style (IDE rules) at build time, not just in the IDE. IDE0005
      (unused usings) additionally needs the compiler's documentation pass, which also validates
      every XML doc comment (crefs, param tags); CS1591 is suppressed because these are
      applications and test suites, not published libraries, so not every public member needs one.
    -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!--
      Issue #16: this is an independent solution for standalone repo tooling (docs/dotnet_tooling.md),
      not part of app/backend-dotnet's Backend.slnx or tests/conformance's Conformance.slnx. It needs
      its own Directory.Build.props/Directory.Packages.props, but NOT its own global.json: the one
      global.json at the repo root already pins the SDK for every project below it (.NET's lookup
      walks up the directory tree), and this directory is still under the repo root.
    -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
</Project>
