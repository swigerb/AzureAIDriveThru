<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <!--
    Restored only through https://packagefeedproxy.microsoft.io/nuget/v3/index.json
    (configured at the machine level; nuget.org is disabled there — do not add a
    repo-level NuGet.Config that re-enables it or any other feed). Matches the
    convention already established by tests/conformance/Directory.Packages.props.
    Versions below were verified to restore and run against net11.0 in this
    environment before being pinned here.
  -->
  <ItemGroup>
    <!-- YAML for config.yaml and persona prompts/*.yaml (docs/dotnet_mapping.md: PyYAML -> YamlDotNet). -->
    <PackageVersion Include="YamlDotNet" Version="17.0.0" />
    <!-- JSON Schema (draft 2020-12) validation of personas/persona.schema.json and
         personas/menu.schema.json, the SAME schema files the Python backend and CI validate
         against (docs/dotnet_mapping.md: jsonschema -> JsonSchema.Net). -->
    <PackageVersion Include="JsonSchema.Net" Version="7.3.4" />
    <!-- PR #140 R5: managed-identity fallback for upstream realtime auth when no api-key is
         configured (docs/dotnet_mapping.md: azure-identity's DefaultAzureCredential ->
         Azure.Identity's DefaultAzureCredential, the same package family rtmt.py uses). -->
    <PackageVersion Include="Azure.Identity" Version="1.13.2" />
    <!-- Issue #147 (ADR-002): Entra JwtBearer parity for app/backend-dotnet, matching
         entra_auth.py's PyJWT/PyJWKClient-based validation (docs/dotnet_mapping.md). Version
         pinned to the exact build already proven to restore/run against net11.0 in this
         environment: see tests/conformance/Directory.Packages.props, where the same version
         already validates against FakeEntraIssuer in FakeEntraIssuerJwtBearerValidationTests. -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.0.0-rc.1.26425.128" />
    <!-- Test projects -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="xunit.v3.mtp-off" Version="4.0.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0-rc.1.26425.128" />
    <!-- Issue #13 Wave 2 (TimeProvider): FakeTimeProvider lets echo-suppression/greeting-timeout
         tests advance a fake clock deterministically instead of sleeping on the real one;
         verified to restore from the configured feed before being pinned here. -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
  </ItemGroup>
</Project>
