<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <!--
      Every rule in the Security, Reliability, Performance, and Usage categories is a build warning
      (most are off by default at AnalysisLevel=latest); .editorconfig opts out of the few that
      don't fit this codebase.
    -->
    <AnalysisModeSecurity>All</AnalysisModeSecurity>
    <AnalysisModeReliability>All</AnalysisModeReliability>
    <AnalysisModePerformance>All</AnalysisModePerformance>
    <AnalysisModeUsage>All</AnalysisModeUsage>
    <!--
      Enforce .editorconfig code style (IDE rules) at build time, not just in the IDE. IDE0005
      (unused usings) additionally needs the compiler's documentation pass, which also validates
      every XML doc comment (crefs, param tags); CS1591 is suppressed because these are
      applications and test suites, not published libraries, so not every public member needs one.
    -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- No Native AOT (Beth's charter): Azure SDK trimming warnings. JIT + ReadyToRun instead. -->
    <PublishAot>false</PublishAot>
    <!--
      Issue #24-style hygiene, matching tests/conformance/Directory.Build.props: pins the exact
      resolved dependency graph (including transitives) into a committed packages.lock.json per
      project, so CI restoring in locked mode fails loudly instead of silently re-resolving if the
      lock file and Directory.Packages.props versions ever disagree.
    -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
</Project>
