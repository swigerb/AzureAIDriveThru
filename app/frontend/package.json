{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host localhost --port 8000",
    "prebuild": "node scripts/validate-auth-config.mjs",
    "build": "tsc -b && vite build",
    "validate:auth-config": "node scripts/validate-auth-config.mjs",
    "test:auth-mode-matrix": "node scripts/auth-mode-build-matrix.mjs --gate-only",
    "test:auth-mode-matrix:full": "node scripts/auth-mode-build-matrix.mjs --full",
    "preview": "vite preview",
    "format": "prettier --write ./src",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.25.1",
    "@azure/msal-react": "^5.7.2",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "darkreader": "^4.9.133",
    "framer-motion": "^14.2.0",
    "i18next": "^26.4.5",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.2",
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.0.16",
    "react-icons": "^5.7.0",
    "react-use-websocket": "^4.13.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.4",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
