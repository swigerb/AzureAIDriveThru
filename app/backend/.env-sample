# This file contains all the environment variables that are used in the project.

# Host and Port for the application
HOST=localhost
PORT=8000  # Set PORT to 8000
VERBOSE_LOGGING=true # For development, set to true for more detailed logs. Change to false in production.

# Persona packs (issue #70). Leave unset for local dev — defaults to <repo root>/personas,
# every folder with a persona.json enabled, and "sonic" as the default persona.
# PERSONAS_DIR=/app/personas
# PERSONAS=sonic
# DEFAULT_PERSONA=sonic

# Public base URLs of each deployed backend (issue #74, design doc section 5.2/10.1),
# reported verbatim as `backends[].url` in `GET /api/personas` so a client can switch
# hosts across backends (e.g. the F11 header switch) without hardcoding one origin.
# azd outputs both from infra/main.bicep (#93). Leave BACKEND_URI unset for local dev —
# the python backend then reports "" (same origin) instead of omitting itself. Leave
# BACKEND_DOTNET_URI unset when no .NET backend is deployed for this environment — it is
# then omitted from `backends` entirely, not reported with a placeholder URL.
# BACKEND_URI=https://<your python container app>.<region>.azurecontainerapps.io
# BACKEND_DOTNET_URI=https://<your dotnet container app>.<region>.azurecontainerapps.io

# Azure OpenAI East US 2 Realtime
AZURE_OPENAI_EASTUS2_ENDPOINT=wss://<your endpoint>.openai.azure.com
AZURE_OPENAI_EASTUS2_API_KEY="<your api key>"
AZURE_OPENAI_REALTIME_DEPLOYMENT=gpt-realtime-2.1

# Microsoft Foundry (issue #82): endpoint for the cascade pipeline's chat model, reached
# via the Azure AI Inference SDK with DefaultAzureCredential only (no API key). Only
# needed if a persona's `models.cascade` config or an `AZURE_AI_MODEL_DEPLOYMENTS` entry
# selects a cascade model -- omit entirely for a realtime-only deployment.
# AZURE_AI_FOUNDRY_ENDPOINT=https://<your foundry resource>.services.ai.azure.com

# Local on-device mode (issue #81, ADR-001 decision 7): base URL of the companion local-runtime
# process (STT/LLM/TTS all running on-device -- see docs/persona-architecture.md's local-mode
# design section and README.md's "On-device local mode" setup instructions). Local mode is OFF
# by default for every persona (cloud stays the default everywhere) -- setting this is the ONLY
# thing that makes a persona's `models.local` catalog entry (e.g. phi-4-mini-local) selectable at
# all; leave it unset to keep local mode fully inactive.
# LOCAL_RUNTIME_ENDPOINT=http://localhost:8100
# Piper voice name the local pipeline's /v1/speak call uses by default (NOT an Azure realtime
# voice choice like AZURE_OPENAI_REALTIME_VOICE_CHOICE above -- local TTS voices are Piper's own
# naming, e.g. en_US-amy-medium). Leave unset to use config.yaml's model.local_default_voice.
# LOCAL_RUNTIME_VOICE_CHOICE=en_US-amy-medium

# Azure OpenAI East US
AZURE_OPENAI_EASTUS_ENDPOINT=https://<your endpoint>.openai.azure.com/
AZURE_OPENAI_EASTUS_API_KEY="<your api key>"
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_GPT4O_DEPLOYMENT=gpt-4o
AZURE_OPENAI_GPT4O_MINI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_REALTIME_VOICE_CHOICE=marin
# Optional overrides of app/backend/config.yaml model.* (leave unset to use config.yaml):
# reasoning.effort for gpt-realtime-2.x: none|minimal|low|medium|high|xhigh, or off to omit it.
# AZURE_OPENAI_REALTIME_REASONING_EFFORT=low
# Is the deployment a reasoning model? true|false|auto (auto = infer from the deployment name,
# so gpt-realtime-1.5 never gets `reasoning`). Set it for custom deployment names.
# AZURE_OPENAI_REALTIME_REASONING_MODEL=auto
# Input transcription model. On Azure it must be deployable by name; whisper-1 works without one.
# AZURE_OPENAI_REALTIME_TRANSCRIPTION_MODEL=whisper-1

# Azure Search
AZURE_SEARCH_ENDPOINT=https://<your endpoint>.search.windows.net
AZURE_SEARCH_INDEX="sonic-menu-items"
AZURE_SEARCH_API_KEY="<your api key>"

# Azure Search Config
AZURE_SEARCH_SEMANTIC_CONFIGURATION=menuSemanticConfig
AZURE_SEARCH_IDENTIFIER_FIELD=id
AZURE_SEARCH_EMBEDDING_FIELD=embedding
AZURE_SEARCH_TITLE_FIELD=name
AZURE_SEARCH_CONTENT_FIELD=description
AZURE_SEARCH_USE_VECTOR_QUERY=true

# Azure Deployment Configuration
AZURE_RESOURCE_GROUP=your-resource-group-name
AZURE_LOCATION=eastus
AZURE_ACR_NAME=youruniqueacrname
AZURE_APP_SERVICE_PLAN=your-app-service-plan-name
AZURE_KEY_VAULT=your-key-vault-name
AZURE_LOG_ANALYTICS=your-log-analytics-name
AZURE_APP_SERVICE_SKU=P1V3
AZURE_DOCKER_IMAGE_TAG=latest
