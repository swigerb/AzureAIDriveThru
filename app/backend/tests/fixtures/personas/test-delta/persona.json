{
  "$schema": "../persona.schema.json",
  "schemaVersion": 1,
  "id": "test-delta",
  "displayName": "Test Delta Meal Co.",
  "roleName": "delta-runner",
  "locales": { "default": "en", "supported": ["en"] },
  "store": { "timezone": "America/New_York" },
  "voice": { "default": "alloy" },
  "search": { "indexName": "test-delta-menu-items", "contentFields": ["description"] },

  "pricing": {
    "taxRate": "0.07",
    "happyHour": null
  },

  "sizes": {
    "canonical": { "regular": "Regular", "large": "Large" },
    "aliases": { "reg": "regular" },
    "spokenAs": {},
    "hidden": ["", "n/a", "none"],
    "default": "regular"
  },

  "bundles": {
    "nameMarkers": ["meal"],
    "convertStandalone": false,
    "missingPartText": { "sides": "a side", "drinks": "a drink" }
  },

  "extras": {
    "allowedBaseCategories": ["drinks"],
    "blockedBaseCategories": ["mains"],
    "splitCombinedNames": true
  },

  "invalidModifiers": {
    "drink": ["onion"]
  },
  "machines": { "delta_machine": { "status": "down", "label": "Delta machine is down" } },

  "models": {
    "realtime": { "default": "gpt-realtime-2.1", "allowed": ["gpt-realtime-2.1"] }
  },

  "strategies": { "searchQueryRewrite": "meal_numbers" },
  "features": { "dayparts": true },

  "ui": {
    "title": "Test Delta Voice Ordering",
    "theme": {
      "light": { "primary": "150 80% 35%", "secondary": "150 40% 25%", "background": "0 0% 96%", "foreground": "0 0% 10%" }
    },
    "assets": { "logo": "assets/logo.svg", "favicon": "assets/favicon.ico" },
    "strings": { "en": { "app.title": "Test Delta Voice Ordering" } },
    "hero": {
      "headline": "Test Delta fixture pack",
      "description": "TEST-ONLY fixture hero description, not a real brand.",
      "callouts": [
        { "title": "CALLOUT ONE", "detail": "Fixture callout one detail.", "tone": "primary" },
        { "title": "CALLOUT TWO", "detail": "Fixture callout two detail.", "tone": "secondary" },
        { "title": "CALLOUT THREE", "detail": "Fixture callout three detail.", "tone": "accent" }
      ],
      "spotlight": [
        { "icon": "assets/spotlight-1.svg", "kicker": "FIXTURE PICK", "title": "Fixture Card One", "rows": [{ "label": "Fixture Row", "value": "Fixture Value" }] },
        { "icon": "assets/spotlight-2.svg", "kicker": "FIXTURE PAIR", "title": "Fixture Card Two", "body": "Fixture body sentence.", "accent": "Fixture pairing suggestion." }
      ]
    },
    "legal": "TEST-ONLY fixture pack (#77) -- not a real brand, used only by the Python backend test suite to prove the shared bundle/extras engines' `bundle.autoFill`, `mealNumber`/`searchQueryRewrite: \"meal_numbers\"`, and `extras.splitCombinedNames` behavior work for ANY real pack."
  }
}
