{
  "$schema": "../persona.schema.json",
  "schemaVersion": 1,
  "id": "test-zeta",
  "displayName": "Test Zeta Meal Co.",
  "roleName": "zeta-runner",
  "locales": { "default": "en", "supported": ["en"] },
  "store": { "timezone": "America/Denver" },
  "voice": { "default": "alloy" },
  "search": { "indexName": "test-zeta-menu-items", "contentFields": ["description"] },

  "pricing": {
    "taxRate": "0.05",
    "happyHour": null
  },

  "sizes": {
    "canonical": { "regular": "Regular", "large": "Large" },
    "aliases": { "reg": "regular" },
    "spokenAs": {},
    "hidden": ["", "n/a", "none"],
    "default": "regular"
  },

  "bundles": {
    "nameMarkers": ["combo"],
    "convertStandalone": false,
    "missingPartText": { "sides": "a side", "drinks": "a drink" },
    "resizeRule": "includedAnySize"
  },

  "extras": {
    "allowedBaseCategories": ["drinks"],
    "blockedBaseCategories": ["mains"],
    "splitCombinedNames": true
  },

  "invalidModifiers": {},
  "machines": {},

  "models": {
    "realtime": { "default": "gpt-realtime-2.1", "allowed": ["gpt-realtime-2.1"] },
    "cascade": { "default": "gpt-5-mini", "allowed": ["gpt-5-mini"] }
  },

  "strategies": { "searchQueryRewrite": "none" },
  "features": { "dayparts": false },

  "ui": {
    "title": "Test Zeta Voice Ordering",
    "theme": {
      "light": { "primary": "210 80% 35%", "secondary": "210 40% 25%", "background": "0 0% 96%", "foreground": "0 0% 10%" }
    },
    "assets": { "logo": "assets/logo.svg", "favicon": "assets/favicon.ico" },
    "strings": { "en": { "app.title": "Test Zeta Voice Ordering" } },
    "hero": {
      "headline": "Test Zeta fixture pack",
      "description": "TEST-ONLY fixture hero description, not a real brand.",
      "callouts": [
        { "title": "CALLOUT ONE", "detail": "Fixture callout one detail.", "tone": "primary" },
        { "title": "CALLOUT TWO", "detail": "Fixture callout two detail.", "tone": "secondary" },
        { "title": "CALLOUT THREE", "detail": "Fixture callout three detail.", "tone": "accent" }
      ],
      "spotlight": [
        { "icon": "assets/spotlight-1.svg", "kicker": "FIXTURE PICK", "title": "Fixture Card One", "rows": [{ "label": "Fixture Row", "value": "Fixture Value" }] },
        { "icon": "assets/spotlight-2.svg", "kicker": "FIXTURE PAIR", "title": "Fixture Card Two", "body": "Fixture body sentence.", "accent": "Fixture pairing suggestion." }
      ]
    },
    "legal": "TEST-ONLY fixture pack (#283) -- not a real brand, used only by ComboComponentResizeConformanceTests' Discovered_* theories to prove the shared includedAnySize component-resize engine (#179/#184) is actually exercised on the dotnet/python conformance legs, since no real shipped pack under personas/ has a bundle whose own bundles.resizeRule is includedAnySize AND leaves a drink slot genuinely open (#274 follow-up E)."
  }
}
